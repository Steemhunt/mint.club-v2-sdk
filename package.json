{
  "name": "@mint.club/v2-sdk",
  "description": "TypeScript SDK for creating, trading, and managing assets on the Mint Club V2 bonding curve protocol.",
  "keywords": [
    "mint-club",
    "bonding-curve",
    "web3",
    "ethereum",
    "base",
    "viem",
    "sdk",
    "defi",
    "token-launch"
  ],
  "homepage": "https://github.com/Steemhunt/mint.club-v2-sdk#readme",
  "bugs": {
    "url": "https://github.com/Steemhunt/mint.club-v2-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Steemhunt/mint.club-v2-sdk.git"
  },
  "files": [
    "./dist/**/*",
    "./src/**/*"
  ],
  "type": "module",
  "license": "BSD-3-Clause",
  "version": "3.0.0",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "browser": {
    "./dist/index.mjs": "./dist/index.mjs",
    "./dist/index.cjs": "./dist/index.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.mjs",
      "require": "./dist/node.cjs",
      "default": "./dist/node.cjs"
    }
  },
  "scripts": {
    "docs:deploy": "",
    "build": "npm run purge && npx pkgroll",
    "build:dev": "npm run purge && npx pkgroll --sourcemap --minify=false",
    "typecheck": "npx tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "purge": "npx rimraf ./dist",
    "test": "npx bun test",
    "test:watch": "npx bun test --watch",
    "deploy": "npm publish"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-dynamic-import-vars": "^2.1.5",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/bun": "^1.4.2",
    "@types/jsdom": "^21.1.7",
    "@types/lodash": "^4.17.25",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "bun": "^1.4.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "pkgroll": "^2.28.1",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "abitype": "^1.3.0",
    "cross-fetch": "^4.1.0",
    "dotenv": "^18.0.5",
    "jsdom": "^25.0.1",
    "lodash": "^4.18.1",
    "merkletreejs": "^0.6.0",
    "viem": "^2.57.2"
  }
}
